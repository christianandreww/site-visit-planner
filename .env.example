# Settings for running the app on your own computer (`npm run dev`).
# Copy this file to a new file named .env and fill in your values.
# Leave the Firebase lines empty and the app runs in demo mode with sample data.
# On Vercel the same names go under Settings → Environment Variables instead.
# Never upload .env anywhere: it holds your passwords.

# Firebase web app config (Firebase console → Project settings → General → Your apps).
# These are built into the page the browser loads, which is fine:
# firestore.rules and Google sign-in are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# OneMap account. Server only: read by /api/search, /api/route and /api/invites.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Optional: calendar invites (README → Calendar invites). Server only.
# The planner calendar's "Secret address in iCal format":
PLANNER_ICAL_URL=
# The planner's email address, shown to reps as a reminder:
PLANNER_EMAIL=
# Only for reps who invite from a different address than they sign in with:
#   signin@gmail.com=work@company.com;other@gmail.com=other.work@company.com
PLANNER_EMAIL_ALIASES=
