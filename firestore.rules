rules_version = '2';

// Multi-user: every signed-in Google account gets its own private data —
// scheduled site visits and permanent custom pins alike. Nobody can read or
// write anyone else's.
//
// Paste this whole file into: Firebase console → Firestore Database →
// Rules → (replace everything) → Publish. No editing needed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/visits/{visitId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/places/{placeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
